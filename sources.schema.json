{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/catenahq/catena-templates/main/sources.schema.json",
  "title": "Catena template source",
  "description": "One hand-edited template definition: the Portainer App Template fields a human owns, plus the x-catena extension block carrying everything the Portainer format has no slot for (SSO wiring, backup quiesce hooks, bench membership, sizing, bilingual prose). sources/<id>.json is canonical; templates.json, catalog.json, blueprints/ and index.html are generated from it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "title", "name", "categories", "platform", "x-catena"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable slug. MUST equal the filename stem. Used as the blueprint directory, the sentinel key, and the id every consumer joins on."
    },
    "type": {
      "const": 3,
      "description": "Portainer template type. 3 = compose stack deployed from a git repository. Catena ships only type 3."
    },
    "title": {"type": "string", "minLength": 1},
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stack name Portainer prefills on deploy."
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "description": "Filter chips in the Portainer catalog. Descriptive app categories, never internal enums."
    },
    "platform": {"enum": ["linux", "windows"]},
    "x-catena": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_name", "upstream_url", "sso_mode", "domain",
        "compose_file", "env_defaults", "bench", "sizing", "en", "fr"
      ],
      "properties": {
        "app_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "upstream_url": {"type": "string", "format": "uri"},
        "sso_mode": {
          "enum": ["pre-wired", "post-deploy-ui", "jackson-curl", "auto", "none", "n/a"]
        },
        "domain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "service", "port"],
          "properties": {
            "host": {"type": "string", "minLength": 1},
            "service": {"type": "string", "minLength": 1},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "compose_file": {"type": "string", "pattern": "^compose/.+\\.ya?ml$"},
        "env_defaults": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*="}
        },
        "env_managed_keys": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "description": "Keys the converge re-injects on every pass. They render to the operator-wired sentinel, never to a real value."
        },
        "postgres_image_override": {
          "type": "string",
          "description": "Only for an app whose upstream cannot run sources/_meta.json postgres_default_image."
        },
        "pg_replay_depends_on": {
          "type": "array",
          "items": {"type": "string"}
        },
        "pause_during_migrate_cutover": {"type": "boolean"},
        "s3_reconcile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service", "check"],
          "description": "Post-restore object-store consistency check. Report-only: it names the orphan rows, it never deletes them, because a bucket that is misconfigured looks exactly like a bucket that is empty.",
          "properties": {
            "service": {"type": "string", "description": "Compose service the check runs inside."},
            "user": {"type": "string", "description": "User to exec as, when the app refuses to run its CLI as root."},
            "check": {"type": "string", "description": "Named check the ops side implements."},
            "db_service": {"type": "string", "description": "Compose service holding the index the check reads."}
          }
        },
        "bench": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pack"],
          "properties": {
            "pack": {"enum": ["postgres", "mariadb", "mongo", "nodb", "embedded"]},
            "fixture": {"enum": ["required", "skip"]},
            "hostname_baked": {"type": "boolean"}
          }
        },
        "quiesce": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pre", "post", "timeout_seconds"],
          "properties": {
            "pre": {"type": "string", "minLength": 1},
            "post": {"type": "string", "minLength": 1},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60}
          }
        },
        "sizing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["peak_ram_mb"],
          "properties": {
            "idle_ram_mb": {"type": ["integer", "null"], "minimum": 1},
            "peak_ram_mb": {
              "type": "integer",
              "minimum": 1,
              "description": "Required. The bench scheduler multiplies it by 1.15 to gate slot acquisition."
            },
            "idle_cpu_pct": {"type": ["number", "null"], "minimum": 0},
            "peak_cpu_pct": {"type": ["number", "null"], "minimum": 0},
            "disk_baseline_mb": {"type": ["integer", "null"], "minimum": 1},
            "notes": {"type": ["string", "null"]},
            "notes_fr": {"type": ["string", "null"]}
          }
        },
        "en": {"$ref": "#/$defs/prose"},
        "fr": {"$ref": "#/$defs/prose"}
      }
    }
  },
  "$defs": {
    "prose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "what_it_is", "replaces", "compose_description", "setup_steps"],
      "properties": {
        "display_name": {"type": "string", "minLength": 1},
        "what_it_is": {"type": "string", "minLength": 1},
        "replaces": {"type": "array", "items": {"type": "string"}},
        "compose_description": {"type": "string", "minLength": 1},
        "setup_steps": {"type": "string"},
        "extra_notes": {"type": "string"}
      }
    }
  }
}
