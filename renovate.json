{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>catenahq/renovate-config"],
  "docker-compose": {
    "description": "The catalog's image pins (blueprints/<id>/docker-compose.yml and the central postgres default in sources/_meta.json) are moved by the catena-admin update engine's repository job (catenahq/renovate engine-bump.yml), the same decision a host makes for a running service. Renovate does not manage them, so the two cannot disagree.",
    "enabled": false
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm dev-deps (minor+patch)",
      "automerge": true
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm runtime (minor+patch)",
      "automerge": true
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchManagers": ["pep723"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python pep723 (minor+patch)",
      "automerge": true
    }
  ],
  "ignorePaths": [
    "**/node_modules/**"
  ]
}
